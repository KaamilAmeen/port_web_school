# Copy this file to .env and replace the placeholders with real values.
# Never commit .env, .env.local or any real credentials.
# Placeholder values are ignored by the app, so the labelled demo content stays active.

# Sanity: create a project at https://www.sanity.io/manage and copy its Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR_SANITY_PROJECT_ID
NEXT_PUBLIC_SANITY_DATASET=production
# Use an ISO date, for example 2026-11-01. See https://www.sanity.io/docs/api-versioning
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Formspree: create two forms at https://formspree.io and copy each ID (the part after /f/).
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=YOUR_FORMSPREE_CONTACT_FORM_ID
NEXT_PUBLIC_FORMSPREE_ADMISSION_ID=YOUR_FORMSPREE_ADMISSION_FORM_ID

# Public site origin, without a trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, server-only. A Sanity Viewer token is only needed for live preview / draft mode.
# Never prefix private tokens with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=YOUR_SANITY_VIEWER_TOKEN
